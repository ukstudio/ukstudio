<!doctype html>
<html prefix="og: http://ogp.me/ns#">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-9XZH9K61N7"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-9XZH9K61N7');
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <% if page.title == 'index' %>
    <title><%= config.title %></title>
    <meta property="og:title" content="<%= config.title %>">
    <% else %>
    <title><%= h page.title %> - <%= config.title %></title>
    <meta property="og:title" content="<%= h page.title %> - <%= config.title %>">
    <% end %>
    <meta name="description" content="<%= h page.description %>">
    <meta property="og:description" content="<%= h page.description %>">
    <meta property="og:url" content="<%= config.host %><%= page.permalink %>">
    <meta property="og:image" content="<%= config.og_image %>">
    <meta property="og:site_name" content="<%= config.title %>">
    <meta property="og:type" content="article">

    <meta name="twitter:card" content="summary">
    <meta name="twitter:image" content="<%= config.og_image %>">

    <link rel="canonical" href="<%= config.host %><%= page.permalink %>">
    <link rel="alternate" type="application/atom+xml" title="<%= config.title %>" href="/feed.xml">

    <link rel="icon" type="image/x-icon" href="/assets/images/favicon.ico">
    <link href="/assets/stylesheets/styles.css" rel="stylesheet">
    <script src="//instant.page/5.1.1" type="module" integrity="sha384-MWfCL6g1OTGsbSwfuMHc8+8J2u71/LA8dzlIN3ycajckxuZZmF+DNjdm7O6H3PSq"></script>
  </head>
  <body class="md:text-base text-sm">
    <div class="container max-w-screen-lg mx-auto py-6 px-4">
      <main class="flex flex-col md:flex-row">
        <article class="flex-1 pb-4">
          <div class="content-card max-w-[70ch] mx-auto">
            <header class="mb-10">
              <a href="/" class="site-title text-lg"><%= config.title %></a>
            </header>
            <header>
              <h1 class="mb-0"><%= h page.title %></h1>
              <p class="mt-1 page-meta">Updated on <%= page.updated.strftime('%b %e, %Y') %></p>
              <% if page.tags.any? %>
              <p class="mt-1 page-meta">
                <% page.tags.each do |tag| %>
                <a href="/tags/<%= tag %>/">#<%= h tag %></a>
                <% end %>
              </p>
              <% end %>
            </header>
            <section class="article-body">
              <%= content %>
            </section>
          </div>
        </article>
        <aside class="backlinks w-64 md:pl-8 order-last">
          <div class="mb-8">&nbsp;</div>
          <h2>Backlinks</h2>
          <% if site.backlinks(page).any? %>
            <ul>
              <% site.backlinks(page).each do |link| %>
                <li>
                  <a href="<%= link.permalink %>"><%= h link.title %></a>
                </li>
              <% end %>
            </ul>
          <% else %>
              <p>No backlinks found.</p>
          <% end %>
        </aside>
      </main>
    </div>
  </body>
</html>
